# 워커 EC2용 환경변수 템플릿 — cp .env.worker.example .env.worker 후 실제값 입력.
# docker-compose.prod-worker.yml 이 참조한다. (실제 .env.worker는 gitignore)

# ── 서비스 EC2(앱+RabbitMQ+Redis) 사설 IP ──
RABBITMQ_HOST=10.0.0.10
REDIS_HOST=10.0.0.10
RABBITMQ_PORT=5672
REDIS_PORT=6379

# ── RabbitMQ 계정 (⚠️ guest 금지 — 원격 접속 불가. 서비스 EC2 .env.prod와 동일하게) ──
RABBITMQ_USERNAME=scorecard
RABBITMQ_PASSWORD=change-me

# ── 실제 AWS S3 (AWS_S3_ENDPOINT 미설정 → 실 S3) ──
AWS_S3_BUCKET=scorecard-uploads-xxxxxxxxxxxx-ap-northeast-2-an
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ── 청크 크기 (t3.small 2GB 메모리 튜닝; 인스턴스 키우면 256MB로 상향 가능) ──
TARGET_CHUNK_SIZE_BYTES=134217728
MIN_CHUNK_SIZE_BYTES=33554432
