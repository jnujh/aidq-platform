# 전용 벤치 EC2용 환경변수 템플릿 — cp .env.bench.example .env.bench 후 실제값 입력.
# docker-compose.bench.yml 이 참조. (실제 .env.bench 는 gitignore)

# ── 벤치 전용 RabbitMQ 계정 (이 박스 내부 전용, 아무 값) ──
RABBITMQ_USERNAME=bench
RABBITMQ_PASSWORD=benchpass

# ── 실제 AWS S3 (AWS_S3_ENDPOINT 미설정 → 실 S3) ──
AWS_S3_BUCKET=scorecard-uploads-xxxxxxxxxxxx-ap-northeast-2-an
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ── 청크 크기 (8vCPU/16GB 기준 128MB) ──
TARGET_CHUNK_SIZE_BYTES=134217728
MIN_CHUNK_SIZE_BYTES=33554432
